# Copy to .env.local and adjust. Never put tokens or passwords here.

# Default server: prod | stand | custom (the choice in the UI overrides it)
VITE_ZORIA_SERVER=prod

# Own API address for the "custom" server, e.g. a local mock
# VITE_ZORIA_API_URL=http://localhost:8080/api/v1

# SHA-256 of the station public key (64 hex). The live and stand keys published
# on 23.09 are built in (src/config/servers.ts); set these only to override them.
# VITE_ZORIA_PROD_KEY_FINGERPRINT=
# VITE_ZORIA_STAND_KEY_FINGERPRINT=
# VITE_ZORIA_CUSTOM_KEY_FINGERPRINT=

# One-time application code (email from watching@zoria.net or @zoria_net_bot).
# Put it into .env.local only: under npm run dev it fills the form for the live
# server, never the stand. Builds leave it out.
# VITE_ZORIA_INVITATION=
